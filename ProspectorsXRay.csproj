<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ProspectorsXRay</AssemblyName>
    <RootNamespace>ProspectorsXRay</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <VSDir Condition="'$(VSDir)' == '' and '$(OS)' == 'Windows_NT'">$(APPDATA)\Vintagestory</VSDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VSDir)\VintagestoryAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VintagestoryLib">
      <HintPath>$(VSDir)\VintagestoryLib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSSurvivalMod">
      <HintPath>$(VSDir)\Mods\VSSurvivalMod.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VSEssentials">
      <HintPath>$(VSDir)\Mods\VSEssentials.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(VSDir)\Lib\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="protobuf-net">
      <HintPath>$(VSDir)\Lib\protobuf-net.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VSDir)\Lib\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="SkiaSharp">
      <HintPath>$(VSDir)\Lib\SkiaSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OpenTK.Graphics">
      <HintPath>$(VSDir)\Lib\OpenTK.Graphics.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="modinfo.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="modicon.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="PackageMod" AfterTargets="Build">
    <PropertyGroup>
      <ReleasesDir>$(ProjectDir)releases</ReleasesDir>
      <VsModsDir Condition="'$(VsModsDir)' == '' and '$(OS)' == 'Windows_NT'">$(APPDATA)\VintagestoryData\Mods</VsModsDir>
      <ModZipName>ProspectorsXRay.zip</ModZipName>
      <ZipOut>$(ReleasesDir)\$(ModZipName)</ZipOut>
    </PropertyGroup>
    <MakeDir Directories="$(ReleasesDir)" />
    <Delete Files="$(ZipOut)" Condition="Exists('$(ZipOut)')" />
    <Exec Command="tar.exe -a -c -f &quot;$(ZipOut)&quot; -C &quot;$(TargetDir.TrimEnd('\'))&quot; $(TargetName).dll $(TargetName).pdb $(TargetName).xml modinfo.json modicon.png" />
    <!-- Remove any obsolete version-stamped zips in Mods to prevent duplicates -->
    <ItemGroup>
      <OldZips Include="$(VsModsDir)\ProspectorsXRay*.zip" />
      <OldZips2 Include="$(VsModsDir)\ProspectorBetterInstinct*.zip" />
      <OldZips3 Include="$(VsModsDir)\ProspectorsInstinct*.zip" />
    </ItemGroup>
    <Delete Files="@(OldZips)" Condition="'$(VsModsDir)' != '' and Exists('$(VsModsDir)')" />
    <Delete Files="@(OldZips2)" Condition="'$(VsModsDir)' != '' and Exists('$(VsModsDir)')" />
    <Delete Files="@(OldZips3)" Condition="'$(VsModsDir)' != '' and Exists('$(VsModsDir)')" />
    <!-- Deploy ProspectorsXRay.zip to Vintage Story Mods folder -->
    <Copy SourceFiles="$(ZipOut)" DestinationFolder="$(VsModsDir)" Condition="'$(VsModsDir)' != '' and Exists('$(VsModsDir)')" />
  </Target>

</Project>
